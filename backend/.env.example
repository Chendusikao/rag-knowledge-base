# Copy this file to backend/.env and adjust for the deployment environment.
RAG_AUTH_SESSION_HOURS=8
RAG_AUTH_COOKIE_SECURE=false
RAG_BOOTSTRAP_LOCAL_ONLY=true
RAG_PASSWORD_PBKDF2_ITERATIONS=600000
RAG_STORAGE_ENCRYPTION_CONFIGURED=false

# 企业总资料库只读根目录。一级文件夹会显示为可导入分支；原文件不会被修改。
RAG_KNOWLEDGE_SOURCE_ROOT=E:/path/to/enterprise-library
RAG_KNOWLEDGE_SOURCE_SCAN_LIMIT=10000
RAG_KNOWLEDGE_SOURCE_IMPORT_LIMIT=500

# JSON array when the frontend is served from another approved origin.
RAG_CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
