# Backend environment (copy to .env and fill in). .env is git-ignored.

# ---- DeepSeek 接入（PLAN: 真实模型） ----
# 1) 填入你的 DeepSeek API Key（https://platform.deepseek.com）。切勿提交真实 key。
RAG_DEEPSEEK_API_KEY=

# 2) 生成环节：让问答用 DeepSeek 真实作答（替换 MockLLM）。
#    前端/接口用 backend="local" 即走 get_llm()，默认 LLM provider 设为 deepseek 即生效。
# RAG_DEFAULT_LLM_PROVIDER=deepseek

# 3) 重排环节：用 DeepSeek 作为 LLM-as-reranker 对 RRF 融合后的候选重排序。
#    设为 deepseek 且仅在已填 key 时启用；未启用则回退 RRF 顺序。
# RAG_RERANK_PROVIDER=deepseek

# 可选覆盖（默认 https://api.deepseek.com / deepseek-chat）
# RAG_DEEPSEEK_BASE_URL=https://api.deepseek.com
# RAG_DEEPSEEK_MODEL=deepseek-chat

# ---- 本地嵌入（可选，接 Qwen3 等本地模型需先装 sentence-transformers） ----
# RAG_DEFAULT_EMBEDDING_PROVIDER=local
# RAG_LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
